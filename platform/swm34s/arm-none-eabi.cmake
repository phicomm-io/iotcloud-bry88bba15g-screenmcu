set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m33)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GNU_DIR "$ENV{HOME}/.cache/phicomm/toolchains/arm-gnu-toolchain-13.3.rel1-x86_64-arm-none-eabi" CACHE PATH "Arm GNU 13.3.Rel1")
set(CMAKE_C_COMPILER "${ARM_GNU_DIR}/bin/arm-none-eabi-gcc")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_OBJCOPY "${ARM_GNU_DIR}/bin/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${ARM_GNU_DIR}/bin/arm-none-eabi-size")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m33 -mthumb -mfloat-abi=soft -Os -flto -ffunction-sections -fdata-sections -ffp-contract=off")
set(CMAKE_ASM_FLAGS_INIT "-mcpu=cortex-m33 -mthumb -mfloat-abi=soft")
